// Lush wire protocol. Source of truth for every message between client and
// server. Run `make protocol` after editing; never edit generated code.
//
// Rules:
//  - Bump ProtocolVersion.Current on EVERY change to this file.
//  - Prefer additive changes (new fields at the end of a table).
//  - Every message on the wire is an Envelope.
//  - A Snapshot of 100 entities must stay well under 1,200 bytes.

namespace protocol;

// The protocol version. The value of Current is the version constant.
// Hello carries it; a server that sees a different value replies with Reload.
enum ProtocolVersion : ushort {
  Current = 14
}

// Position of an entity, in world units (metres) from the map origin.
struct Vec2 {
  x: float;
  z: float;
}

// Input.actions bit flags.
enum ActionFlags : ubyte (bit_flags) {
  Interact,
  Attack,
  Jump,
  Run    // held while the player is running (D-044)
}

// Entity.animation values, shared by server and client.
enum Animation : ubyte {
  Idle = 0,
  Walk = 1,
  Wave = 2,
  Chop = 3,  // looping while woodcutting
  Fish = 4,  // looping while fishing
  Cook = 5   // looping while cooking
}

// Emotes a client can request with EmoteSend.
enum Emote : ubyte {
  Wave
}

// Item ids are uint16. EmptyItem.Id (0) marks an empty inventory slot or an
// empty equipment slot; real items never use id 0.
enum EmptyItem : ushort {
  Id = 0
}

// ItemDef.kind values.
enum ItemKind : ubyte {
  Loot = 0,
  Weapon = 1,
  Armor = 2,
  Food = 3
}

// ItemDef.equip_slot values. None for items that can't be equipped.
enum EquipSlot : ubyte {
  None = 0,
  Weapon = 1,
  Head = 2,
  Body = 3,
  Shield = 4
}

// One inventory slot. An empty slot is item_id EmptyItem.Id, quantity 0.
struct InventorySlot {
  item_id: uint16;
  quantity: uint32;
}

// EntityInfo.kind values.
enum EntityKind : ubyte {
  Player = 0,
  Npc = 1
}

// One entity's health bar inside EntityHealth. Packed to 4 bytes.
struct HealthRatio {
  id: uint16;    // entity id, as in Entity.id
  ratio: uint8;  // hp / max_hp scaled to 0..255 (0 = dead, 255 = full)
}

// One item lying on the ground inside GroundItems. Packed to 12 bytes.
struct GroundItem {
  id: uint16;        // ground item id, session-scoped; PickUp names it
  item_id: uint16;   // ItemDef.id
  quantity: uint32;
  x: int16;          // decimetres (0.1 m) from the map origin, as in Entity
  z: int16;          // decimetres (0.1 m) from the map origin, as in Entity
}

// One hit inside CombatHit. Packed to 6 bytes.
struct Hit {
  attacker: uint16; // entity id of the attacker, as in Entity.id
  target: uint16;   // entity id of the target, as in Entity.id
  damage: uint8;    // HP removed from the target; 0 means a miss
  died: bool;       // true when this hit killed the target
}

// One offered item inside TradeState. Packed to 8 bytes.
struct TradeItem {
  item_id: uint16;   // ItemDef.id
  quantity: uint32;
}

// A player or NPC inside a Snapshot. Packed to 8 bytes.
// Ids are session-scoped 16-bit entity ids (also used as player id).
struct Entity {
  id: uint16;
  x: int16;         // decimetres (0.1 m) from the map origin
  z: int16;         // decimetres (0.1 m) from the map origin
  rotation: uint8;  // facing, 0..255 = 0..2*pi radians
  animation: uint8; // Animation value
}

// Client -> server, first message on a connection.
table Hello {
  protocol_version: ushort;
  guest_token: string; // empty or absent for a new guest
}

// Server -> client, reply to an accepted Hello.
table Welcome {
  player_id: ushort;
  guest_token: string;
  spawn: Vec2;
  tick_rate: ubyte; // server ticks per second
  walk_speed: float; // metres per second (D-044)
  run_speed: float;  // metres per second (D-044)
  server_time_ms: ulong; // server clock when sent: Unix epoch milliseconds, UTC (D-050)
}

// Client -> server, one per client tick.
table Input {
  seq: uint32;      // input sequence number, increases by 1 per input
  move: Vec2;       // movement vector, each axis -1..1 (x = east, z = south)
  facing: float;    // radians
  actions: ubyte;   // ActionFlags bits
}

// Server -> client, per tick, only entities in view.
table Snapshot {
  tick: uint32;
  last_input_seq: uint32; // last Input.seq the server processed for this client
  entities: [Entity];
}

table ChatSend {
  text: string;
}

table ChatMessage {
  speaker_id: ushort;
  text: string;
}

table Ping {
  token: uint32;
}

// Echoes Ping.token.
table Pong {
  token: uint32;
}

// Server -> client: protocol mismatch or server restart, reload the page.
table Reload {
  reason: string;
}

// Server -> client: seconds until a graceful restart, for the in-game countdown.
table RestartCountdown {
  seconds_remaining: ushort;
}

// Client -> server: play an emote.
table EmoteSend {
  emote: Emote;
}

// Server -> client: the player's own stats.
table PlayerStats {
  hp: ushort;
  max_hp: ushort;
  combat_level: ubyte;
  xp: uint32;
  gold: uint32;
}

// Server -> client: the player's whole inventory and equipment.
// The slot count is slots.length (set by the server); empty slots are
// sent explicitly. Equipment fields are EmptyItem.Id when nothing is worn.
table InventoryState {
  slots: [InventorySlot];
  weapon: ushort;
  head: ushort;
  body: ushort;
  shield: ushort;
}

// One item definition in the ItemCatalog.
table ItemDef {
  id: ushort;
  name: string;
  kind: ItemKind;
  equip_slot: EquipSlot;
  level_to_equip: ubyte;   // 0 when the item can't be equipped
  accuracy: short;         // equipment bonuses; may be negative
  strength: short;
  defence: short;
  attack_speed: ubyte;     // combat ticks per attack; 0 for non-weapons
  heal: ushort;            // HP restored when eaten; 0 for non-food
  shop_buys_for: uint32;   // gold the shop pays the player for one
  shop_sells: bool;        // false: the shop doesn't sell this item
  shop_sells_for: uint32;  // gold the player pays the shop; only if shop_sells
}

// Server -> client: every item definition, so the client doesn't hard-code
// the item table.
table ItemCatalog {
  items: [ItemDef];
}

// Server -> client: how to draw one entity. Sent when the entity comes into
// view and again whenever any of these fields changes. Snapshot entities
// carry only position and animation; the client keeps this per entity id.
table EntityInfo {
  id: ushort;              // entity id, as in Entity.id
  kind: EntityKind;
  npc_type: ushort;        // NPC type id from the NPC table; 0 for players
  combat_level: ubyte;
  weapon: ushort;          // visible equipment item ids; EmptyItem.Id if none
  head: ushort;
  body: ushort;
  shield: ushort;
}

// Server -> client: health bars for entities in view whose health changed.
// Entities not listed keep their last ratio (full when never sent).
table EntityHealth {
  entries: [HealthRatio];
}

// ItemAction.action values.
enum ItemActionKind : ubyte {
  Equip = 0,   // equip the item in inventory slot `slot`
  Unequip = 1, // move the item worn in `equip_slot` back to the inventory
  Eat = 2      // eat the food in inventory slot `slot`
}

// Client -> server: equip, unequip or eat an item. Equip and Eat use `slot`
// (an inventory slot index); Unequip uses `equip_slot`. The server checks
// everything and replies with InventoryState and PlayerStats.
table ItemAction {
  action: ItemActionKind;
  slot: ubyte;           // inventory slot index, 0-based
  equip_slot: EquipSlot;
}

// Server -> client: every ground item in view. Each message replaces the
// whole list; it is sent when the list changes.
table GroundItems {
  items: [GroundItem];
}

// Client -> server: pick up a ground item.
table PickUp {
  ground_item_id: ushort; // GroundItem.id
}

// Client -> server: buy from the NPC shop.
table ShopBuy {
  item_id: ushort;   // ItemDef.id
  quantity: uint32;
}

// Client -> server: sell from an inventory slot to the NPC shop.
table ShopSell {
  slot: ubyte;       // inventory slot index, 0-based
  quantity: uint32;
}

// ShopResult.code values.
enum ShopResultCode : ubyte {
  Ok = 0,
  TooFar = 1,
  NotEnoughGold = 2,
  InventoryFull = 3,
  ItemNotSold = 4
}

// Server -> client: the outcome of a ShopBuy or ShopSell.
table ShopResult {
  code: ShopResultCode;
}

// Client -> server: start attacking an entity. The server checks range,
// area and target rules and ignores invalid requests.
table AttackTarget {
  target_id: ushort; // entity id, as in Entity.id
}

// Server -> client: every hit of one combat tick involving entities in view,
// for hitsplats. A hit with damage 0 is a miss. A hit with died set killed
// its target; the client plays the death and the server stops sending the
// entity (or respawns it) afterwards.
table CombatHit {
  tick: uint32;  // world tick of the combat tick, as in Snapshot.tick
  hits: [Hit];
}

// One NPC type in the NpcCatalog.
table NpcDef {
  id: ushort;          // NPC type id, as in EntityInfo.npc_type
  name: string;
  combat_level: ubyte;
}

// Server -> client: every NPC type, so the client doesn't hard-code NPC
// names and levels.
table NpcCatalog {
  npcs: [NpcDef];
}

// Client -> server: ask a nearby player to trade, or accept a pending
// request by naming the player who sent it. The server checks distance
// (3 tiles) and the PvP zone and replies with TradeState or TradeResult.
table TradeRequest {
  target_id: ushort; // entity id, as in Entity.id
}

// Client -> server: add items from one inventory slot to your offer.
table TradeOffer {
  slot: ubyte;       // inventory slot index, 0-based
  quantity: uint32;
}

// Client -> server: take one item back off your offer.
table TradeRemove {
  index: ubyte;      // index into your offer, as in TradeState.my_items
}

// Client -> server: set the gold on your offer (replaces the old amount).
table TradeSetGold {
  gold: uint32;
}

// Client -> server: accept the screen you are looking at. The server
// ignores it if screen isn't the current TradeState.screen, so an accept
// sent just before the offer changed doesn't count.
table TradeAccept {
  screen: ubyte;     // 1 or 2
}

// Client -> server: close the trade window and cancel the trade.
table TradeCancel {
}

// Server -> client: another player wants to trade with you. Reply with
// TradeRequest naming them to accept.
table TradeRequestNotice {
  from_id: ushort;   // entity id of the requesting player
}

// Server -> client: the whole trade window, sent when the trade opens and
// whenever anything in it changes. Any change to an offer returns both
// players to screen 1 and clears both accept flags. "my" is the receiving
// player's side; "partner" is the other player's.
table TradeState {
  partner_id: ushort;      // entity id of the other player
  screen: ubyte;           // 1 (offer) or 2 (final confirmation)
  my_items: [TradeItem];
  my_gold: uint32;
  partner_items: [TradeItem];
  partner_gold: uint32;
  my_accepted: bool;       // you accepted the current screen
  partner_accepted: bool;  // the partner accepted the current screen
}

// TradeResult.code values.
enum TradeResultCode : ubyte {
  Completed = 0,      // both accepted screen 2; the swap was saved
  Cancelled = 1,      // either player cancelled or left
  TooFar = 2,         // the players are more than 3 tiles apart
  InPvpZone = 3,      // one of the players is in the PvP zone
  PartnerBusy = 4,    // the other player is already trading
  OfferNotHeld = 5,   // a side no longer has what it offered at commit
  InventoryFull = 6   // a side has no room for what it would receive
}

// Server -> client: the trade window closed (or a request failed), and why.
table TradeResult {
  code: TradeResultCode;
}

// Card tables (D-016, docs/specs/card-tables.md). The CardTable* messages
// are the shared table system: the table catalog with stakes, seats, Ready,
// turns, the turn timer and the winner. They work for any game and never
// carry cards, hands or moves; each game has its own messages (Shed* below),
// and a client is only ever sent its own cards.

// One table inside CardTableCatalog. Packed to 8 bytes.
struct CardTableInfo {
  id: uint16;    // table id, as in CardTableSit.table_id
  seats: uint8;  // number of seats at the table
  stake: uint32; // gold each seated player puts into the pot when a game starts
}

// Server -> client: every card table with its seat count and stake, so the
// stake can be shown before a player sits.
table CardTableCatalog {
  tables: [CardTableInfo];
}

// Client -> server: sit in the first free seat of a table. The server
// replies with CardTableResult, and with CardTableState on success.
table CardTableSit {
  table_id: ushort;
}

// Client -> server: leave the table you are seated at.
table CardTableLeave {
}

// Client -> server: you are ready to start a game at the table you are
// seated at. A game starts when at least 2 players are seated and all of
// them are ready. The server replies with CardTableResult, and with
// CardTableState on success.
table CardTableReady {
}

// Server -> client: the public seat and turn state of one table, sent to
// everyone seated at it whenever it changes.
table CardTableState {
  table_id: ushort;
  seats: [uint16];         // entity id in each seat, 0 for an empty seat
  in_progress: bool;       // a game is being played
  turn_seat: ubyte;        // seat index whose turn it is (in_progress only)
  reversed: bool;          // turn order runs backwards
  turn_ticks_left: uint32; // world ticks until the turn times out
  has_winner: bool;        // the last game ended with a winner
  winner_seat: ubyte;      // seat index of the winner (has_winner only)
  ready: [bool];           // per seat, as in seats: that player pressed Ready
}

// CardTableResult.code values.
enum CardTableResultCode : ubyte {
  Ok = 0,             // the sit or leave succeeded
  UnknownTable = 1,   // no table has that table_id
  TableFull = 2,      // every seat at the table is taken
  AlreadySeated = 3,  // you are already seated at a table
  NotSeated = 4,      // you are not seated at a table
  InProgress = 5,     // a game is in progress, so you can't sit or leave now
  NotYourTurn = 6,    // the move was sent when it isn't your turn
  IllegalMove = 7,    // the move breaks the game's rules (or names a card you don't hold)
  NoGame = 8,         // no game is in progress at your table, so there is nothing to play
  NotEnoughGold = 9,  // you don't have the gold for the table's stake
  TooFar = 10         // you are too far from the table to sit at it
}

// Server -> client: the outcome of a CardTableSit, CardTableLeave,
// CardTableReady or a game move (such as ShedPlay or ShedDraw).
table CardTableResult {
  code: CardTableResultCode;
}

// Shed, the first card game (docs/specs/card-tables.md). A card is a
// colour plus a symbol. Wild and WildDrawFour cards have colour None.

// ShedCard.colour values. The client picks the campus-themed display names
// and art for colours One to Four.
enum ShedColour : ubyte {
  None = 0,  // Wild and WildDrawFour cards
  One = 1,
  Two = 2,
  Three = 3,
  Four = 4
}

// ShedCard.symbol values. Zero to Nine are the number cards.
enum ShedSymbol : ubyte {
  Zero = 0,
  One = 1,
  Two = 2,
  Three = 3,
  Four = 4,
  Five = 5,
  Six = 6,
  Seven = 7,
  Eight = 8,
  Nine = 9,
  Skip = 10,
  Reverse = 11,
  DrawTwo = 12,
  Wild = 13,
  WildDrawFour = 14
}

// One Shed card. Packed to 2 bytes.
struct ShedCard {
  colour: ShedColour;
  symbol: ShedSymbol;
}

// Client -> server: play a card from your hand on your turn. Identical
// cards are interchangeable, so the card is named by value. For a Wild or
// WildDrawFour, chosen_colour is the colour that must be matched next (not
// None); for other cards it is ignored. The server replies with
// CardTableResult, and on success sends new ShedState and ShedHand.
table ShedPlay {
  card: ShedCard;
  chosen_colour: ShedColour;
}

// Client -> server: draw one card on your turn; the turn passes. The server
// replies with CardTableResult, and on success sends new ShedState and
// ShedHand.
table ShedDraw {
}

// Server -> client: the public Shed state of one table, sent to everyone
// seated at it whenever it changes. Turn order and the timer are in
// CardTableState.
table ShedState {
  table_id: ushort;
  top_card: ShedCard;      // the face-up top card of the discard pile
  colour: ShedColour;      // the colour to match (the chosen colour after a Wild)
  hand_counts: [ubyte];    // cards in each seat's hand, as in CardTableState.seats
  draw_pile: ubyte;        // cards left in the draw pile
}

// Server -> client: the receiving player's own Shed hand. Sent only to
// that player; other players' cards are never sent.
table ShedHand {
  table_id: ushort;
  cards: [ShedCard];
}

// Skills (D-051, docs/specs/skills.md). Levels are 1..30. XP is sent in
// tenths of a point, because some XP rewards have a half point (Oak 37.5).

// Skill values.
enum Skill : ubyte {
  Woodcutting = 0,
  Fishing = 1,
  Cooking = 2
}

// Server -> client: the player's own skill levels and XP. Sent on join and
// whenever any of them changes.
table SkillStats {
  woodcutting_level: ubyte;
  woodcutting_xp: uint32;   // tenths of an XP point
  fishing_level: ubyte;
  fishing_xp: uint32;       // tenths of an XP point
  cooking_level: ubyte;
  cooking_xp: uint32;       // tenths of an XP point
}

// SkillAction.target values.
enum SkillTarget : ubyte {
  Tree = 0,         // target_id is a tree id from the shared map data
  FishingSpot = 1,  // target_id is a fishing spot id from the shared map data
  Grill = 2         // target_id is ignored; there is one grill
}

// Client -> server: start chopping a tree, fishing at a spot or cooking at
// the grill. The server checks range, level and tool, replies with
// SkillResult, and keeps trying on its own until it stops.
table SkillAction {
  target: SkillTarget;
  target_id: ushort;
}

// One fishing spot inside ResourceState. Packed to 4 bytes.
struct FishingSpotState {
  id: uint16;        // fishing spot id from the shared map data
  candidate: uint8;  // index into that spot's candidate positions in the map data
}

// Server -> client: which trees are felled (shown as stumps) and where each
// fishing spot currently is. Each message replaces the whole state; it is
// sent on join and whenever it changes. Trees not listed are standing.
table ResourceState {
  felled_trees: [uint16];          // tree ids from the shared map data
  fishing_spots: [FishingSpotState];
}

// Server -> client: an entity in view reached a new skill level, for the
// chat log message and the effect nearby players see.
table LevelUp {
  entity_id: ushort;  // entity id, as in Entity.id
  skill: Skill;
  level: ubyte;       // the new level
}

// SkillResult.code values.
enum SkillResultCode : ubyte {
  Started = 0,        // the action started
  Success = 1,        // one item gathered or cooked (item_id)
  Burnt = 2,          // the fish burnt (item_id is the burnt fish)
  NeedTool = 3,       // no tool for this resource (item_id is the tool needed)
  NeedLevel = 4,      // level too low (level is the level needed)
  InventoryFull = 5,  // no room for the item
  ResourceGone = 6,   // the tree is felled or the fishing spot moved
  NothingToCook = 7,  // no raw fish in the inventory
  OutOfRange = 8,     // too far from the target
  Stopped = 9         // the action stopped (the player moved or combat started)
}

// Server -> client: the outcome of a SkillAction or of one attempt, for the
// chat log. Fields that don't apply are 0 (item_id EmptyItem.Id).
table SkillResult {
  skill: Skill;
  code: SkillResultCode;
  item_id: ushort;   // ItemDef.id, where one applies
  level: ubyte;      // the level needed, for NeedLevel
}

// Bank (D-051, docs/specs/skills.md: Bank). 200 slots; every item stacks,
// so one slot holds any number of one item. Gold is not banked.

// BankDeposit.amount and BankWithdraw.amount: All means every one the player
// has (deposit) or every one in the bank (withdraw).
enum BankAmount : uint {
  All = 4294967295
}

// One bank slot inside BankState. Packed to 16 bytes. The quantity is 64
// bits so a fully stacked slot can never overflow.
struct BankSlot {
  item_id: uint16;   // ItemDef.id
  quantity: uint64;
}

// Client -> server: open the bank at the booth (within 2 tiles). The server
// replies with BankResult, and on success sends BankState.
table BankOpen {
}

// Client -> server: close the bank panel. No reply.
table BankClose {
}

// Server -> client: the whole bank, sent when it opens and whenever it
// changes while open. Lists the filled slots in order, at most 200.
table BankState {
  slots: [BankSlot];
}

// Client -> server: move amount of item_id from the inventory into the bank
// (BankAmount.All for every one). The server replies with BankResult.
table BankDeposit {
  item_id: ushort;   // ItemDef.id
  amount: uint32;    // or BankAmount.All
}

// Client -> server: move amount of item_id from the bank into the inventory
// (BankAmount.All for every one). The server replies with BankResult.
table BankWithdraw {
  item_id: ushort;   // ItemDef.id
  amount: uint32;    // or BankAmount.All
}

// Client -> server: deposit the whole inventory. The server replies with
// BankResult.
table BankDepositInventory {
}

// Client -> server: deposit everything equipped. The server replies with
// BankResult.
table BankDepositEquipment {
}

// BankResult.code values.
enum BankResultCode : ubyte {
  Ok = 0,
  TooFar = 1,          // more than 2 tiles from the bank booth
  InCombat = 2,        // the bank can't be opened or used during combat
  InPvpZone = 3,       // the bank can't be opened or used in the PvP zone
  BankFull = 4,        // all 200 slots are used by other items
  InventoryFull = 5,   // no room in the inventory for the withdrawal
  NotEnoughItems = 6,  // fewer items than the amount asked for
  Busy = 7,            // an earlier bank request is still being saved
  NotOpen = 8          // the bank isn't open
}

// Server -> client: the outcome of a BankOpen, BankDeposit, BankWithdraw,
// BankDepositInventory or BankDepositEquipment.
table BankResult {
  code: BankResultCode;
}

union Message {
  Hello,
  Welcome,
  Input,
  Snapshot,
  ChatSend,
  ChatMessage,
  Ping,
  Pong,
  Reload,
  RestartCountdown,
  EmoteSend,
  PlayerStats,
  InventoryState,
  ItemCatalog,
  EntityInfo,
  EntityHealth,
  ItemAction,
  GroundItems,
  PickUp,
  ShopBuy,
  ShopSell,
  ShopResult,
  AttackTarget,
  CombatHit,
  NpcCatalog,
  TradeRequest,
  TradeOffer,
  TradeRemove,
  TradeSetGold,
  TradeAccept,
  TradeCancel,
  TradeRequestNotice,
  TradeState,
  TradeResult,
  CardTableSit,
  CardTableLeave,
  CardTableState,
  CardTableResult,
  CardTableReady,
  CardTableCatalog,
  ShedPlay,
  ShedDraw,
  ShedState,
  ShedHand,
  SkillStats,
  SkillAction,
  ResourceState,
  LevelUp,
  SkillResult,
  BankOpen,
  BankClose,
  BankState,
  BankDeposit,
  BankWithdraw,
  BankDepositInventory,
  BankDepositEquipment,
  BankResult
}

table Envelope {
  msg: Message;
}

root_type Envelope;
