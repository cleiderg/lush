# Template for /etc/lush/staging.env on the VM. Copy, then fill in real values on the
# server only. Never commit secrets: the database URL below is a passwordless
# placeholder (peer auth over the local socket) and the Sentry DSN is set on
# the server, not here.
LUSH_ENV=staging
LUSH_LISTEN_ADDR=127.0.0.1:8081
LUSH_WS_ORIGINS=staging.example.com
LUSH_DATABASE_URL=postgres:///lush_staging?host=/var/run/postgresql
