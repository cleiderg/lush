# Template for /etc/lush/production.env on the VM. Copy, then fill in real values on the
# server only. Never commit secrets: the database URL below is a passwordless
# placeholder (peer auth over the local socket) and the Sentry DSN is set on
# the server, not here.
LUSH_ENV=production
LUSH_LISTEN_ADDR=127.0.0.1:8080
LUSH_WS_ORIGINS=play.example.com
LUSH_DATABASE_URL=postgres:///lush_production?host=/var/run/postgresql
