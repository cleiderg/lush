# Template for /etc/lush/production.env on the VM. Copy, then fill in real values on the
# server only. Never commit secrets: the database URL below is a placeholder
# for the Vultr Managed PostgreSQL cluster on the private network (D-007).
# On the server, replace DB_HOST and the port with the cluster's private
# address and add the password (postgres://lush:<password>@...). The Sentry DSN
# is also set on the server, not here.
LUSH_ENV=production
LUSH_LISTEN_ADDR=127.0.0.1:8080
LUSH_WS_ORIGINS=play.example.com
LUSH_DATABASE_URL=postgres://lush@DB_HOST:5432/lush_production?sslmode=require
